# ---------- Core ----------
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000
WEB_URL=http://localhost:3000

# ---------- MongoDB ----------
MONGODB_URI=mongodb://localhost:27017/email_automation

# ---------- Auth ----------
# Sign your own: openssl rand -hex 32
JWT_SECRET=generate-with-openssl-rand-hex-32
JWT_EXPIRES_IN=7d
# 32-byte hex key used to encrypt provider refresh tokens at rest
TOKEN_ENCRYPTION_KEY=generate-with-openssl-rand-hex-32

# ---------- Google OAuth (Gmail API) ----------
# console.cloud.google.com -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# ---------- Microsoft OAuth (Graph API) ----------
# entra.microsoft.com -> App registrations
MICROSOFT_CLIENT_ID=your-microsoft-application-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
MICROSOFT_TENANT_ID=common
MICROSOFT_CALLBACK_URL=http://localhost:4000/api/auth/microsoft/callback

# ---------- AI ----------
OPENAI_API_KEY=your-api-key
OPENAI_MODEL=gpt-4o-mini
# Set to 'true' to run without an OpenAI key (uses a deterministic stub)
AI_MOCK=false

# ---------- Automation ----------
SYNC_CRON=*/5 * * * *
SYNC_ENABLED=true

# ---------------------------------------------------------------------------
# IMAP / SMTP  (for mailboxes with no OAuth — cPanel, SiteGround, Zoho, etc.)
# Only needed for `npm run imap:check`; the app itself takes these from the
# connect form on the sign-in page.
# ---------------------------------------------------------------------------
IMAP_HOST=sgp13.siteground.asia
IMAP_PORT=993
IMAP_SECURE=true
SMTP_HOST=sgp13.siteground.asia
SMTP_PORT=465
SMTP_SECURE=true
IMAP_FOLDER=INBOX
MAIL_USER=you@yourdomain.com
MAIL_PASS=your-mailbox-password

# ---------------------------------------------------------------------------
# Attachment reading — PDFs and images are parsed and their text is given to
# the model alongside the email body.
# ---------------------------------------------------------------------------
ATTACHMENT_PARSING=true
ATTACHMENT_MAX_MB=10
ATTACHMENT_MAX_CHARS=6000
# OCR for images (screenshots, photos of documents). Language data is fetched
# from a CDN on first use; if that is blocked, download eng.traineddata and
# point ATTACHMENT_OCR_PATH at the folder holding it.
ATTACHMENT_OCR=true
ATTACHMENT_OCR_LANG=eng
# ATTACHMENT_OCR_PATH=C:\tessdata

# ---------------------------------------------------------------------------
# Added during the reliability/security pass
# ---------------------------------------------------------------------------
# Origins allowed to call this API with credentials (comma separated).
# Defaults to WEB_URL when unset.
CORS_ORIGINS=http://localhost:3000

# OpenAI-compatible endpoint. Required for OpenRouter, NVIDIA NIM, LM Studio.
# An OpenRouter key with no base URL is rejected and every draft silently
# falls back to the keyword stub.
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_TIMEOUT_MS=45000
OPENAI_MAX_RETRIES=2
OPENAI_MAX_TOKENS=1200

# Hard ceiling on automated replies per mailbox per rolling 24 hours.
DAILY_SEND_CAP=200
# Emails drafted in one automation run.
AUTOMATION_BATCH=50
# How long a send may hold its lock before another worker may retry it (ms).
SEND_LOCK_MS=120000

# Sync tuning
SYNC_BATCH_SIZE=40
SYNC_INITIAL_LOOKBACK_DAYS=7

# Attachments read per message.
ATTACHMENT_MAX_PER_MESSAGE=8

# TLS certificate checking for IMAP/SMTP. Leave ON. Set to false only if your
# host serves a certificate for the server hostname rather than the mail
# domain — it disables man-in-the-middle protection on a connection that
# carries your mailbox password.
IMAP_TLS_REJECT_UNAUTHORIZED=true
